# Copy to .env to override the defaults. Everything has a working default for
# `docker-compose up`, so this file is optional. Never commit .env.

# ---- LLM ---------------------------------------------------------------------
# "mock" (default) is deterministic and needs no API key.
# "anthropic" calls the Claude API and requires ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# ---- Admin API ---------------------------------------------------------------
# Sent as the x-admin-key header by the admin dashboard. At least 16 characters.
# Change it for anything other than local use.
ADMIN_API_KEY=dev-admin-key-change-me

# ---- Postgres (used by Docker Compose) ---------------------------------------
POSTGRES_USER=refunds
POSTGRES_PASSWORD=refunds
POSTGRES_DB=refunds
# Host port Postgres is published on.
POSTGRES_HOST_PORT=5433

# ---- Backend on the host (npm run start:dev) ---------------------------------
# Inside Compose the backend builds its own DATABASE_URL from the POSTGRES_*
# values above, so these two only matter when running outside Docker.
DATABASE_URL=postgresql://refunds:refunds@localhost:5433/refunds
PORT=3001
